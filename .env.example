# Copy to .env and edit. The code does not load .env automatically; export it with:
#   set -a; source .env; set +a
# Every value below has a working default except RELAY_PUBLIC_HOST, RELAY_SHIELD_SECRET and OPENAI_API_KEY.

# --- AWS (server, scheduler, resume Lambda) ---
AWS_REGION=us-west-2
RELAY_TASKS_TABLE=RelayTasks
RELAY_AUDIT_TABLE=RelayAudit
RELAY_SCHEDULER_ROLE=RelaySchedulerInvokeRole
RELAY_RESUME_LAMBDA=RelayResumeWorker

# --- Server: public hostname(s) allowed by host validation (comma-separated) ---
# Required on a deployed host, e.g. abc123.ecs.us-west-2.on.aws. Leave empty for localhost only.
RELAY_PUBLIC_HOST=

# --- Relay Shield (family scam protection) ---
# REQUIRED. Server secret that approval codes are derived from. Must be a long random value,
# for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value. On ECS, store it as a task secret.
RELAY_SHIELD_SECRET=

# --- Optional Bedrock agent layer (python -m scripts.run_agent) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/v1
RELAY_MODEL=openai.gpt-oss-20b

# --- Test and benchmark scripts (defaults point at the demo deployment) ---
# RELAY_MCP_URL=
# RELAY_HEALTH_URL=
# RELAY_BENCH_RUNS=50
# RELAY_BENCH_WARMUP=5
# RELAY_BENCH_TASK_ID=